[sub_resource type="Shader" id="Shader_5x4b8"]
code = "shader_type canvas_item;

uniform vec4 base_color : source_color = vec4(0.0);
uniform vec4 shine_color : source_color = vec4(1.0);
uniform float shine_speed : hint_range(0.0, 10.0, 0.1) = 4.0;
uniform float shine_size : hint_range(0.01, 1.0, 0.01) = 0.001;

void fragment() {
	COLOR = texture(TEXTURE, UV);
	COLOR.rgb += base_color.rgb;
	float shine = step(1.0 - shine_size * 0.5, 0.5 + 0.5 * sin(UV.x - UV.y + TIME * shine_speed));
	COLOR.rgb = mix(COLOR.rgb, shine_color.rgb, shine * shine_color.a);
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_q0wi5"]
